{
  "schema": "raios.c5.chat-contract.v1",
  "endpoint": "POST http://127.0.0.1:8766/v1/chat",
  "request": {"text_aliases": ["text", "message"], "language_aliases": ["language", "locale"], "stream_accepted": true, "streaming_response": false, "timeout_seconds": {"default": 120, "minimum": 1, "maximum": 600}},
  "validation": {"blank_text": "HTTP_422 EMPTY_TEXT", "oversize": "HTTP_422"},
  "success": {"http": 200, "required": ["status", "conversation_id", "model", "language", "response", "content", "reply"], "aliases_equal": true},
  "upstream_timeout": {"http": 504, "error": "MAIN_CORTEX_TIMEOUT"},
  "upstream_failure": {"http": 502, "error": "MAIN_CORTEX_UNAVAILABLE"},
  "compatibility_preserved": ["/health", "/v1/chat"]
}