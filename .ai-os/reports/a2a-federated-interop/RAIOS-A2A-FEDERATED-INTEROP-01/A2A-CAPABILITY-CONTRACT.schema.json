{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raios:a2a:capability-contract:v1",
  "title": "A2A-CAPABILITY-CONTRACT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "CAPABILITY_ID",
    "SEMANTIC_VERSION",
    "INPUT_SCHEMA",
    "OUTPUT_SCHEMA",
    "AUTHORITY_CLASS",
    "RISK_CLASS",
    "DATA_DOMAINS",
    "TOOLS_REQUIRED",
    "MODEL_REQUIRED",
    "OFFLINE_CAPABLE",
    "SIDE_EFFECTS",
    "REVERSIBLE",
    "COST_CLASS",
    "EVIDENCE_REQUIREMENTS",
    "TIMEOUT",
    "IDEMPOTENCY_SUPPORTED"
  ],
  "properties": {
    "CAPABILITY_ID": { "type": "string", "minLength": 1 },
    "SEMANTIC_VERSION": { "type": "string" },
    "INPUT_SCHEMA": { "type": "object" },
    "OUTPUT_SCHEMA": { "type": "object" },
    "AUTHORITY_CLASS": { "type": "string" },
    "RISK_CLASS": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"] },
    "DATA_DOMAINS": { "type": "array", "items": { "type": "string" } },
    "TOOLS_REQUIRED": { "type": "array", "items": { "type": "string" } },
    "MODEL_REQUIRED": { "type": "boolean" },
    "OFFLINE_CAPABLE": { "type": "boolean" },
    "SIDE_EFFECTS": { "type": "boolean" },
    "REVERSIBLE": { "type": "boolean" },
    "COST_CLASS": { "type": "string" },
    "EVIDENCE_REQUIREMENTS": { "type": "array", "items": { "type": "string" } },
    "TIMEOUT": { "type": "number" },
    "IDEMPOTENCY_SUPPORTED": { "type": "boolean" },
    "PUBLIC_SAFE_SUBSET": { "type": "boolean" }
  }
}
