{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raios.c1c5.task-envelope.v1",
  "title": "RAIOS C1-C5 task envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "actor",
    "target",
    "mode",
    "intent",
    "risk_class",
    "writes_allowed",
    "correlation_id",
    "idempotency_key",
    "requested_capability",
    "parameters",
    "authority_context_reference"
  ],
  "properties": {
    "schema_version": {
      "const": "raios.c1c5.task-envelope.v1"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "description": "Request data only. Never a grant."
    },
    "target": {
      "type": "string",
      "enum": [
        "C5",
        "C5@AG",
        "C5-PUBLIC"
      ]
    },
    "mode": {
      "type": "string",
      "enum": [
        "READ_ONLY",
        "NOOP"
      ]
    },
    "intent": {
      "type": "string"
    },
    "risk_class": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "writes_allowed": {
      "type": "boolean"
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "requested_capability": {
      "type": "string",
      "minLength": 1
    },
    "parameters": {
      "type": "object"
    },
    "authority_context_reference": {
      "type": "string",
      "description": "Must match server-side founder session_id/correlation_id or identity bind. ACTOR=C1 is not sufficient."
    }
  }
}
