{
  "schema": "raios.route-registry.v1",
  "ts_note": "Alias/route map over existing keepers. Not a message bus. Not Repair control plane.",
  "host": "cursor",
  "root": "/workspace",
  "tree_id": "C2-CLOUD",
  "law": [
    "ENVELOPE_NE_BUS",
    "NO_ALTERNATE_CONTROL_PLANE",
    "C5_FOUNDER_FAIL_CLOSED_UNTIL_PROVEN",
    "ALL_IS_PER_TARGET_RECEIPT_NE_FILE_COPY",
