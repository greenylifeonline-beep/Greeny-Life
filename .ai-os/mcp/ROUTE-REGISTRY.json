    },
    "C5-PUBLIC": {
      "keeper": "scripts/ai-os/raios_c5_screen.py POST /api/chat lane=PUBLIC :8765",
      "auth": "none-public-lane",
      "live_this_host": true,
      "status": "LOCAL_ONLY",
      "reason": "same-host loopback; not AG Cursor.exe forward"
    },
    "C5-FOUNDER": {
      "keeper": "scripts/ai-os/raios_c5_screen.py lane=C1 :8876",
      "auth": "optional RAIOS_C1_SCREEN_TOKEN",
      "live_this_host": false,
      "status": "BLOCKED_ROUTING",
      "reason": "fail-closed: Cloud 8876 is this VM C1 console, not AG founder channel"
    },
    "C6": {
      "keeper": null,
      "auth": "n/a",
      "live_this_host": false,
      "status": "ABSENT",
      "reason": "C6 unseated on SEAT-MAP; AG C6 executor is not this host"
    },
    "ALL": {
      "keeper": "per-target dispatch via this registry",
      "auth": "per-target",
      "live_this_host": false,
      "status": "UNPROVEN",
      "reason": "ALL requires message_id+correlation_id+target+auth+ACK+receipt+return_path per live seat; C5-FOUNDER fail-closed; C6 ABSENT; C1 BLOCKED_AUTH"
    }
  },
  "gl005_proven": false
}
