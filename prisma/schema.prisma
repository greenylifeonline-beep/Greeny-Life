datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Organization {
  id        String   @id @default(uuid())
  code      String   @unique
  nameAr    String
  nameEn    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  entities  Entity[]
}

model Entity {
  id           String       @id @default(uuid())
  orgId        String
  organization Organization @relation(fields: [orgId], references: [id])
  code         String       @unique
  nameAr       String
  nameEn       String
  country      String
  warehouses   Warehouse[]
  suppliers    Supplier[]
  customers    Customer[]
  salesOrders  SalesOrder[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

model Supplier {
  id            String    @id @default(uuid())
  entityId      String
  entity        Entity    @relation(fields: [entityId], references: [id])
  supplierId    String    @unique
  nameAr        String
  nameEn        String
  contactPerson String?
  email         String?
  phone         String?
  country       String    @default("Egypt")
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id])
  productId   String   @unique
  nameAr      String
  nameEn      String
  category    String
  marketRules Json?
  skus        SKU[]
  batches     Batch[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SKU {
  id           String           @id @default(uuid())
  productId    String
  product      Product          @relation(fields: [productId], references: [id])
  skuCode      String           @unique
  barcode      String?
  unitPriceUSD Float
  weightKg     Float
  packaging    Packaging[]
  inventories  Inventory[]
  orderItems   SalesOrderItem[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Batch {
  id             String   @id @default(uuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  batchCode      String   @unique
  productionDate DateTime
  expiryDate     DateTime
  qcPassed       Boolean  @default(false)
  traceability   Json?
  createdAt      DateTime @default(now())
}

model Packaging {
  id          String   @id @default(uuid())
  skuId       String
  sku         SKU      @relation(fields: [skuId], references: [id])
  packageType String
  dimensions  String?
  labelCode   String?
  createdAt   DateTime @default(now())
}

model Warehouse {
  id            String      @id @default(uuid())
  entityId      String
  entity        Entity      @relation(fields: [entityId], references: [id])
  warehouseCode String      @unique
  nameAr        String
  nameEn        String
  location      String
  inventories   Inventory[]
  createdAt     DateTime    @default(now())
}

model Inventory {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  skuId       String
  sku         SKU       @relation(fields: [skuId], references: [id])
  quantity    Int       @default(0)
  reservedQty Int       @default(0)
  updatedAt   DateTime  @updatedAt
}

model Customer {
  id           String       @id @default(uuid())
  entityId     String
  entity       Entity       @relation(fields: [entityId], references: [id])
  customerCode String       @unique
  name         String
  country      String
  email        String?
  salesOrders  SalesOrder[]
  createdAt    DateTime     @default(now())
}

model SalesOrder {
  id          String           @id @default(uuid())
  entityId    String
  entity      Entity           @relation(fields: [entityId], references: [id])
  orderCode   String           @unique
  customerId  String
  customer    Customer         @relation(fields: [customerId], references: [id])
  status      String           @default("CREATED")
  totalAmount Float
  currency    String           @default("USD")
  items       SalesOrderItem[]
  shipments   Shipment[]
  invoices    Invoice[]
  auditLogs          AuditLog[]
  workflowApprovals  WorkflowApproval[]
  createdAt          DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model SalesOrderItem {
  id            String     @id @default(uuid())
  orderId       String
  salesOrder    SalesOrder @relation(fields: [orderId], references: [id])
  skuId         String
  sku           SKU        @relation(fields: [skuId], references: [id])
  quantity      Int
  unitPriceUSD  Float
  totalPriceUSD Float
}

model Shipment {
  id          String     @id @default(uuid())
  orderId     String
  salesOrder  SalesOrder @relation(fields: [orderId], references: [id])
  trackingNo  String     @unique
  carrier     String?
  containerNo String?
  status      String     @default("PREPARING")
  etd         DateTime?
  eta         DateTime?
  documents   Document[]
  createdAt   DateTime   @default(now())
}

model Document {
  id         String    @id @default(uuid())
  shipmentId String?
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  docType    String
  fileUrl    String
  issuedBy   String?
  createdAt  DateTime  @default(now())
}

model Invoice {
  id         String     @id @default(uuid())
  orderId    String
  salesOrder SalesOrder @relation(fields: [orderId], references: [id])
  invoiceNo  String     @unique
  amountUSD  Float
  status     String     @default("PENDING")
  payments   Payment[]
  createdAt  DateTime   @default(now())
}

model Payment {
  id             String   @id @default(uuid())
  invoiceId      String
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  amountUSD      Float
  method         String
  transactionRef String?
  paidAt         DateTime @default(now())
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  role         String   @default("EMPLOYEE")
  department   String?
  passwordHash String?
  createdAt    DateTime @default(now())
}

model AuditLog {
  id         String      @id @default(uuid())
  orderId    String?
  salesOrder SalesOrder? @relation(fields: [orderId], references: [id])
  action     String
  actor      String
  details    Json?
  createdAt  DateTime    @default(now())
}

// A one-time, human-approved gate for an existing order workflow transition.
// Approval is not execution: it is consumed only inside the same transaction
// that updates the order state and writes the workflow audit record.
model WorkflowApproval {
  id          String     @id @default(uuid())
  orderId     String
  salesOrder  SalesOrder @relation(fields: [orderId], references: [id])
  targetState String
  requestedBy String
  approvedBy  String?
  status      String     @default("PENDING_APPROVAL")
  expiresAt   DateTime
  approvedAt  DateTime?
  executedAt  DateTime?
  correlationId String   @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([orderId, targetState, status])
  @@index([expiresAt, status])
  @@index([requestedBy, createdAt])
}

// Commercial facts are time-bound. They are deliberately recorded before any
// operational master record is changed, so pricing, suppliers, shipping and
// offers remain traceable and reversible.
model CommercialChange {
  id            String    @id @default(uuid())
  domain        String
  subjectType   String
  subjectId     String
  changeType    String
  status        String    @default("PROPOSED")
  riskLevel     String
  source        String
  payload       Json
  rationale     String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  requestedBy   String
  reviewedBy    String?
  reviewedAt    DateTime?
  correlationId String    @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([domain, subjectType, subjectId, status])
  @@index([effectiveFrom, effectiveTo])
}

// Immutable operational trace ledger. A record is created for a received raw
// material, a processing/packaging output, or a re-export plan. It never
// substitutes legal customs or ownership documents; it preserves their chain.
model TradeTraceRecord {
  id                String   @id @default(uuid())
  traceCode         String   @unique
  recordType        String
  parentTraceCode   String?
  sourceParty       String
  holderCompany     String
  destinationParty  String?
  materialName      String
  batchCode         String
  quantity          Float
  unit              String
  originCountry     String
  processingCountry String?
  status            String   @default("REVIEW_REQUIRED")
  ownershipHistory  Json
  evidence          Json?
  correlationId     String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([parentTraceCode])
  @@index([holderCompany, status])
  @@index([batchCode])
}

// Outcome evidence is append-only operational learning input. It never grants
// approval or changes a model, policy, master record, or commercial action.
model DecisionOutcome {
  id              String   @id @default(uuid())
  decisionId      String
  contextId       String
  metric          String
  expectedValue   Float
  actualValue     Float
  variance        Float
  variancePercent Float?
  unit            String
  status          String   @default("REVIEW_REQUIRED")
  evidenceIds     Json
  notes           String?
  observedAt      DateTime
  recordedBy      String
  correlationId   String   @unique
  createdAt       DateTime @default(now())

  @@index([decisionId, createdAt])
  @@index([contextId, metric, observedAt])
  @@index([status])
}

// A reviewed training case is derived from exactly one persisted outcome.
// It is not a model deployment, policy change, or execution authorization.
model TrainingCase {
  id               String   @id @default(uuid())
  outcomeId        String   @unique
  decisionId       String
  contextId        String
  metric           String
  expectedDecision String
  actualDecision   String
  rootCause        String?
  learningSignal   String
  evidenceIds      Json
  status           String   @default("REVIEW_REQUIRED")
  recordedBy       String
  correlationId    String   @unique
  createdAt        DateTime @default(now())

  @@index([decisionId, createdAt])
  @@index([contextId, metric])
  @@index([status])
}

// A benchmark record evaluates a candidate against reviewed training cases.
// It deliberately has no deployment, promotion, or authority side effect.
model EvaluationRun {
  id               String   @id @default(uuid())
  evaluationKey    String   @unique
  candidateVersion String
  baselineVersion  String?
  trainingCaseIds  Json
  metricScores     Json
  score            Float
  status           String
  notes            String?
  recordedBy       String
  correlationId    String   @unique
  createdAt        DateTime @default(now())

  @@index([candidateVersion, createdAt])
  @@index([status])
}

// A durable, idempotent task record. Task creation is never commercial execution.
model OrchestrationTask {
  id             String   @id @default(uuid())
  taskType       String
  ownerCompany   String
  subjectId      String
  requestedBy    String
  executor       String
  status         String   @default("REVIEW_REQUIRED")
  priority       String   @default("MEDIUM")
  evidenceIds    Json
  dependsOn      Json
  payload        Json
  outputContract String
  idempotencyKey String   @unique
  correlationId  String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([ownerCompany, status, createdAt])
  @@index([subjectId, taskType])
  @@index([executor, status])
}

// Security events are append-only operational audit evidence.
model SecurityAuditEvent {
  id         String   @id @default(uuid())
  route      String
  action     String
  actorEmail String?
  role       String?
  outcome    String
  reason     String
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([route, outcome])
  @@index([actorEmail, createdAt])
}

// Evidence is submitted separately from verification. It never authorizes execution.
model OfficialEvidenceRegistry {
  id                 String    @id @default(uuid())
  evidenceKey        String    @unique
  product            String
  destination        String
  authority          String    @default("unknown")
  verificationStatus String    @default("unverified")
  claimStatus        String    @default("unknown")
  validTo            DateTime?
  gates              Json
  sourceUrl          String?
  sourceTitle        String
  sourceExcerpt      String?
  submittedBy        String
  reviewedBy         String?
  reviewedAt         DateTime?
  reviewNotes        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([product, destination, verificationStatus])
  @@index([claimStatus])
}
