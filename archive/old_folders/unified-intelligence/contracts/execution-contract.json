{
  "name": "Unified Intelligence Execution Contract",
  "version": "1.0.0",
  "pipeline": [
    {
      "stage": 1,
      "name": "brain",
      "role": "orchestrate"
    },
    {
      "stage": 2,
      "name": "intelligence",
      "role": "analyze"
    },
    {
      "stage": 3,
      "name": "gl-dos",
      "role": "govern"
    },
    {
      "stage": 4,
      "name": "master-data",
      "role": "resolve-canonical-data"
    },
    {
      "stage": 5,
      "name": "memory",
      "role": "persist-context"
    },
    {
      "stage": 6,
      "name": "knowledge",
      "role": "provide-reference-context"
    },
    {
      "stage": 7,
      "name": "reports",
      "role": "produce-traceable-output"
    }
  ],
  "rules": {
    "no_direct_legacy_authority": true,
    "no_report_as_source_of_truth": true,
    "no_engine_without_registry": true,
    "no_destructive_cleanup_without_backup": true,
    "no_master_data_mutation_without_governance": true
  }
}
