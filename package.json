  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "data:preflight": "node scripts/data-import-preflight.cjs",
    "legacy-brain": "python scripts/brain_safe_entry.py",
    "intelligence": "node scripts/legacy-health.cjs",
    "audit": "node scripts/legacy-health.cjs --audit",
    "health": "npm run type-check && npm run intelligence && npm run audit",
    "migration": "node scripts/legacy-health.cjs --blocked-migration",
    "migration:verify": "node scripts/legacy-health.cjs --blocked-migration",
    "migration:decision": "node scripts/legacy-health.cjs --blocked-migration",
    "migration:executor": "node scripts/legacy-health.cjs --blocked-migration",
    "migration:all": "node scripts/legacy-health.cjs --blocked-migration",
    "test:intelligence": "node scripts/legacy-health.cjs --test",
    "test:registry": "node scripts/legacy-health.cjs --test",
    "test:health": "node scripts/legacy-health.cjs --test",
    "test:cleanup": "node scripts/legacy-health.cjs --test",
    "test:duplicate-v2": "node scripts/legacy-health.cjs --test",
    "test:audit": "node scripts/legacy-health.cjs --test",
    "test:integrity": "node scripts/legacy-health.cjs --test",
    "test:domain": "tsx tests/domain_workflow_check.ts",
    "test:traceability": "tsx tests/trade_traceability_check.ts",
    "test:canonical-intelligence": "tsx tests/canonical_intelligence_check.ts",
    "test:mastermind": "tsx tests/mastermind_agents_check.ts",
    "test:operating-brains": "tsx tests/three_operating_brains_check.ts",
    "test:tool-registry": "tsx tests/tool_registry_check.ts",
    "test:commercial-context": "tsx tests/commercial_context_fabric_check.ts",
    "test:commercial-changes": "tsx tests/commercial_change_review_check.ts",
    "test:greeny-life-egypt": "tsx tests/greeny_life_egypt_brain_check.ts",
    "test:workflow-governance": "tsx tests/workflow_governance_check.ts",
    "test:gldos-governance": "tsx tests/gldos_governance_gate_check.ts",
    "test:legacy-brain": "python -B -m unittest tests.test_legacy_brain_runtime -v",
    "test:operational-freshness": "tsx tests/operational_data_freshness_check.ts",
    "test:supplier-quality": "tsx tests/supplier_quality_review_check.ts",
    "test:shipment-tracking": "tsx tests/shipment_tracking_review_check.ts",
    "test:greeny-life-verification": "tsx tests/greeny_life_verification_check.ts",
    "test:controlled-learning": "tsx tests/controlled_learning_check.ts",
    "test:all": "npm run test:intelligence && npm run test:registry && npm run test:health && npm run test:cleanup && npm run test:duplicate-v2",
    "verify": "npm run type-check && npm run intelligence && npm run audit && npm run test:domain && npm run test:traceability && npm run test:canonical-intelligence && npm run test:mastermind && npm run test:operating-brains && npm run test:tool-registry && npm run test:commercial-context && npm run test:commercial-changes && npm run test:greeny-life-egypt && npm run test:workflow-governance && npm run test:gldos-governance && npm run test:legacy-brain && npm run test:operational-freshness && npm run test:supplier-quality && npm run test:shipment-tracking && npm run test:greeny-life-verification && npm run test:controlled-learning && npm run test:all",
    "diagnose": "npm run intelligence",
    "gl-dos": "node scripts/legacy-health.cjs",
    "gl-check": "npm run verify"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1",
    "next": "^16.2.10",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
