# ============================================================================
# Greeny-Life — Root Git Ignore
# ============================================================================

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js build artifacts
node_modules/
.next/
.npm-cache/
out/
dist/
build/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.bak

# RAIOS generated runtime snapshots
.ai-os/snapshots/*.json

# RAIOS generated runtime snapshots
.ai-os/snapshots/*.json
# RAIOS generated/runtime state
.ai-os/install-backups/

# Live C5 learning state lives in the external cognitive store
/.ai-os/learning/C5-MIND.json
/.ai-os/learning/C5-MIND.md
/.ai-os/learning/C5-SCREEN.jsonl
/.ai-os/learning/C5-WHOAMI.md
/.ai-os/learning/CANDIDATES.jsonl
/.ai-os/learning/DIGESTS.jsonl
/.ai-os/learning/INDEX.json
/.ai-os/learning/LAST-SEARCH.json
/.ai-os/learning/MEMORY.json
/.ai-os/learning/MEMORY.md
coverage/
unified-intelligence-restore-*.zip

# Cognitive runtime data lives under ~/.raios/runtime/cognitive-store/v9
/RAIOS/V9/evidence/events/*.json
/RAIOS/V9/performance/a4/*.json
/RAIOS/V9/experience/automatic-a4/*.json
/RAIOS/V9/failures/a4/*.json
/RAIOS/V9/skills/candidates-a4/*.json
