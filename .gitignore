# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next.js build artifacts
node_modules/
.next/
.npm-cache/
out/
dist/
build/
*.tsbuildinfo

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Temporary files
*.tmp
*.temp
*.bak

# RAIOS generated runtime snapshots
.ai-os/snapshots/*.json

# RAIOS generated runtime snapshots
.ai-os/snapshots/*.json
# RAIOS generated/runtime state
.ai-os/install-backups/
coverage/
unified-intelligence-restore-*.zip
