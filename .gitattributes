# Repository line-ending policy.
# Semantic salvage diffs must not be confused with CRLF/LF noise.
* text=auto eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.zip binary
*.7z binary
*.gz binary
*.whl binary
*.exe binary
*.dll binary
*.bin binary
